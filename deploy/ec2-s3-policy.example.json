{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListMarketplaceImages",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<bucket-name>"
    },
    {
      "Sid": "ManageMarketplaceImages",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<bucket-name>/images/*"
    },
    {
      "Sid": "UploadDemoListingImages",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<bucket-name>/demo/*"
    }
  ]
}
